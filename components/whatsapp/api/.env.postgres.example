# Template for running the API, migrations, seeds, and tests against the local
# Docker Compose PostgreSQL/PostGIS (docker-compose.yml). Copy to .env, or export.
# Local-only credentials; never reuse them anywhere else.
APP_ENV=local
POSTGRES_PORT=55432
POSTGRES_PASSWORD=postgres-local-only

# Dev database (migrations + seed).
DATABASE_URL=postgresql+psycopg://postgres:postgres-local-only@localhost:55432/csl_dev

# Integration tests under tests/database/ create and drop their own databases on
# this server. Unset -> those tests are skipped (SQLite demo mode).
TEST_POSTGRES_URL=postgresql+psycopg://postgres:postgres-local-only@localhost:55432/postgres

# 1 (default) = the tenant helper switches to the csl_* group role per actor
# role with SET LOCAL ROLE. The login role must be a member of those roles.
DB_ROLE_SWITCH=1

SEED_DEMO_PASSWORD=
JWT_SECRET=change-me-dev-only
VERIFY_TOKEN=dev-verify-token
