# Copy to .env and fill in. NEVER commit .env (see repo .gitignore).
# In production (Cloud Run) these are set from environment variables, mapped
# from Google Secret Manager; see DEPLOY.md.

# "local" (default) enables dev-friendly defaults. "production" makes startup
# fail fast if any secret below is missing or left at an insecure default, and
# rejects SQLite.
APP_ENV=local

# Database. SQLite is for LOCAL DEV ONLY; production must use Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@/dbname?host=/cloudsql/INSTANCE
DATABASE_URL=sqlite:///./local-data/aid.sqlite3

# JWT signing secret for bearer auth (hackathon: seeded users).
# Generate a strong value for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-dev-only
JWT_EXPIRE_MINUTES=720

# WhatsApp Business Platform (webhook verification + signature check + outbound).
WHATSAPP_TOKEN=
APP_SECRET=
VERIFY_TOKEN=dev-verify-token
PHONE_NUMBER_ID=

# Password for the seeded demo users. Required in production; local dev falls
# back to "local-demo-pass" if unset.
SEED_DEMO_PASSWORD=

# Worker tuning (optional; used by scripts/worker.py).
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=20
