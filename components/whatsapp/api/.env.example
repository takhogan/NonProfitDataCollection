# Copy to .env and fill in. NEVER commit .env (see repo .gitignore).

# Database. SQLite is fine for local dev / demo; swap for Postgres in production:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/aid
DATABASE_URL=sqlite:///./local-data/aid.sqlite3

# JWT signing secret for bearer auth (hackathon: seeded users).
JWT_SECRET=change-me-dev-only
JWT_EXPIRE_MINUTES=720

# WhatsApp Business Platform (webhook verification + future outbound).
WHATSAPP_TOKEN=
APP_SECRET=
VERIFY_TOKEN=dev-verify-token
PHONE_NUMBER_ID=
