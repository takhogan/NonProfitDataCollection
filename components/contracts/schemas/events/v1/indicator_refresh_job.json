{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "area_ids": {
      "items": {
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Area Ids",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "job_type": {
      "const": "indicator_refresh",
      "title": "Job Type",
      "type": "string"
    },
    "operation_key": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "title": "Operation Key",
      "type": "string"
    },
    "organization_id": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "Organization Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "organization_id",
    "operation_key",
    "job_type",
    "area_ids"
  ],
  "title": "IndicatorRefreshJob",
  "type": "object",
  "x-contract-version": "v1"
}
