# Build context is components/ — keep it lean and never ship secrets or local data.
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.egg-info/

**/local-data/
**/*.sqlite
**/*.sqlite3
**/.env
**/.env.*
!**/.env.example

**/tests/
**/.git/
**/.DS_Store
**/*.md

# Only api/ and whatsapp/api/ are needed; ignore sibling components.
web/
contracts/
database/
domain/
operational-worker/
data-worker/
