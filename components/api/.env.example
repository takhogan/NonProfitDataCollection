# Copy to .env; never commit .env.
# The dashboard API shares the database and JWT secret with whatsapp/api so
# logins and data are interoperable.

APP_ENV=local

# SAME database as whatsapp/api. Locally this points at its SQLite file; in
# production use the same Postgres DATABASE_URL (from Secret Manager).
DATABASE_URL=sqlite:///../whatsapp/api/local-data/aid.sqlite3

# MUST match whatsapp/api's JWT_SECRET.
JWT_SECRET=change-me-dev-only
JWT_EXPIRE_MINUTES=720

# Credentialed CORS origins for the frontend (comma-separated).
WEB_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo seed password (scripts/seed_miami.py).
SEED_DEMO_PASSWORD=demo-pass
